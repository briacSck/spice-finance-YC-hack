# ---- Morpho vault backend ----
# Chain: 8453 Base | 1 Ethereum | 84532 Base Sepolia | 11155111 Sepolia
MORPHO_CHAIN_ID=8453
# Optional RPC override (else a sane public default per chain is used).
MORPHO_RPC_URL=
# ERC-4626 vault address. Default below = Steakhouse USDC on Base mainnet.
MORPHO_VAULT=0xbeef0e0834849aCC03f0089F01f4F1Eeb06873C9
# Optional USDC override (else Circle USDC per chain is used).
MORPHO_USDC=
# Morpho offchain API (APY / rewards / position).
MORPHO_GRAPHQL=https://api.morpho.org/graphql
# Wallet that signs deposit/withdraw. NEEDS USDC + a little native gas.
# Leave empty to run info() (read-only) without a key.
WALLET_PRIVATE_KEY=

# ---- Testnet example (Base Sepolia) ----
# MORPHO_CHAIN_ID=84532
# MORPHO_RPC_URL=https://sepolia.base.org
# MORPHO_VAULT=0x...   # deploy via factory 0x4501125508079A99ebBebCE205DeC9593C2b5857
#                      # or point at any ERC-4626 testnet vault
