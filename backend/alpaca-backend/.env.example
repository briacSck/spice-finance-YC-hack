# Client Portal Gateway runs locally; log it in with PAPER creds for paper trading.
IBKR_BASE_URL=https://localhost:5000/v1/api
# Paper account id (starts with "DU"). Get it from GET /iserver/accounts after login.
IBKR_ACCOUNT_ID=DU0000000
# Gateway uses a self-signed cert -> disable TLS verify in dev.
IBKR_VERIFY_TLS=false
# Default order time-in-force and exchange routing.
IBKR_DEFAULT_TIF=DAY
