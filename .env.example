# Alpaca PAPER trading (alpaca-backend) — real values live in .env (gitignored)
ALPACA_KEY=replace_me
ALPACA_SECRET=replace_me
ALPACA_TRADING_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# Quant-engine data / LLM
ALPHA_VANTAGE_API_KEY=replace_me
ENTSOE_SECURITY_TOKEN=replace_me

# Orchestrator -> venue backend URLs (optional; these are the defaults used by
# backend/quant-engine/spice/tools.py if unset). Escrow params live in
# backend/escrow-backend/.env.example.
ALPACA_URL=http://localhost:8001
MORPHO_URL=http://localhost:8002
ESCROW_URL=http://localhost:8003
